# Finlyt backend: copy to .env and fill in. Never commit .env.
# Locally this points at the Neon `dev` branch; set the same keys in Vercel for `main`.

# ── Database (Neon) ────────────────────────────────────────────────
# Neon console → project "finlyt" → Connect. Region: AWS Asia Pacific (Singapore).
# Pooled connection string (the host contains "-pooler"). The API uses this one.
DATABASE_URL=
# Direct connection string (same dialog, pooling switched off). Alembic migrations use this one.
DATABASE_URL_UNPOOLED=

# ── Google sign-in ─────────────────────────────────────────────────
# Google Cloud → Google Auth Platform → Clients → the "Web application" client ID.
# The app asks Google for ID tokens issued to this client; the API rejects any other audience.
GOOGLE_WEB_CLIENT_ID=
# Comma-separated Google account emails allowed to sign in. "*" lets anyone sign in.
ALLOWED_EMAILS=

# ── Gemini (phase 3) ───────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma-separated Gemini models to try in order (default: gemini-3.5-flash,gemini-3.8-flash,gemini-2.5-flash).
GEMINI_MODEL=

# ── Tests (optional) ───────────────────────────────────────────────
# A throwaway Postgres database for `uv run pytest`. Its tables are dropped and recreated.
TEST_DATABASE_URL=
