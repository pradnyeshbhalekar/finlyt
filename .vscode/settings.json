{
  // mobile/android is generated by Expo and built from the terminal. Without these, VS Code's
  // Java and Gradle extensions import it and keep a language server plus several Gradle and
  // Kotlin daemons running (about 10 GB of memory).
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false,
  "java.server.launchMode": "LightWeight",
  "java.configuration.updateBuildConfiguration": "disabled",
  "java.gradle.buildServer.enabled": "off",
  "gradle.autoDetect": "off"
}
