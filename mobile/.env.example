# Finlyt app: copy to .env and fill in.
# EXPO_PUBLIC_* values are compiled into the app bundle, so never put secrets here.
# Restart `npx expo start` after changing this file.

# Backend base URL (no trailing slash).
#   Phone on USB:   run `adb reverse tcp:5050 tcp:5050`, then use http://localhost:5050
#   Phone on Wi-Fi: http://<your Mac's LAN IP>:5050
#   Production:     https://<your-vercel-project>.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:5050

# Google Cloud → Google Auth Platform → Clients → the "Web application" client ID.
# Same value as GOOGLE_WEB_CLIENT_ID in backend/.env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
